# Copy this file to .env and adjust values before running docker-compose
# or the backend/frontend locally.

# --- Postgres / PostGIS ---
POSTGRES_USER=didar
POSTGRES_PASSWORD=didar
POSTGRES_DB=didar
POSTGRES_PORT=5432

# --- Shared secrets (must match across auth + API services) ---
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_SERVICE_KEY=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200
DEFAULT_BRAND_SLUG=didar

# --- Main API ---
HTTP_PORT=8080
DATABASE_URL=postgres://didar:didar@localhost:5432/didar?sslmode=disable
CORS_ORIGINS=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:8081

# --- Auth microservice ---
AUTH_HTTP_PORT=8081
AUTH_DATABASE_URL=postgres://didar:didar@localhost:5432/didar_auth?sslmode=disable

# --- Auth OTP (email by default; set OTP_CHANNEL=sms to restore phone later) ---
OTP_CHANNEL=email
OTP_MOCK_MODE=true
OTP_TTL_MINUTES=2
OTP_CODE_LENGTH=5

# SMTP (used when OTP_CHANNEL=email and OTP_MOCK_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@didar.travel

# Kavenegar (kept for restoring phone SMS auth later)
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=didar-otp
# KAVENEGAR_SENDER_LINE=2000660110

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AUTH_BASE_URL=http://localhost:8081/api/v1
FRONTEND_PORT=5173
