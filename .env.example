# Copy this file to .env and adjust values before running docker-compose
# or the backend/frontend locally.

# --- Postgres / PostGIS ---
POSTGRES_USER=didar
POSTGRES_PASSWORD=didar
POSTGRES_DB=didar
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://didar:didar@localhost:5432/didar?sslmode=disable
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200
DEFAULT_BRAND_SLUG=didar

# --- Kavenegar (SMS / OTP provider, https://kavenegar.com) ---
# Leave KAVENEGAR_API_KEY empty to run in OTP mock mode: codes are
# printed to the backend logs instead of being sent over SMS.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=didar-otp
KAVENEGAR_SENDER_LINE=
OTP_MOCK_MODE=true
OTP_TTL_MINUTES=2
OTP_CODE_LENGTH=5

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=5173
